{
  "name": "resolver",
  "private": true,
  "version": "0.1.0",
  "description": "No-login ticket-routing pilot with a YAML router, SQLite feedback and optional local LLM.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/drax2gma/resolver-public.git"
  },
  "homepage": "https://github.com/drax2gma/resolver-public#readme",
  "keywords": [
    "ticket-routing",
    "sveltekit",
    "sqlite",
    "ollama",
    "yaml"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "vite dev --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "start": "node build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:reset": "rm -f data/resolver.db data/resolver.db-shm data/resolver.db-wal",
    "e2e": "tsx scripts/e2e.ts"
  },
  "dependencies": {
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15",
    "@sveltejs/kit": "^3.1.1",
    "codemirror": "^6.0.2",
    "svelte": "^5.57.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^6.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.6",
    "svelte-check": "^4.7.8",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "imports": {
    "#lib": "./src/lib",
    "#lib/*": "./src/lib/*"
  }
}
