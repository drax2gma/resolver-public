# Resolver SPA — környezeti változók
# Fejlesztéshez másold .env-ra (a Vite betölti); produkcióban add át
# env változóként (systemd EnvironmentFile, konténer env, stb.).

# SQLite tudásbázis
DB_PATH=./data/resolver.db

# Futó config gyökere (router.yaml, tickets/); alapból a cwd.
# DATA_DIR=.

# Model provider: fake | ollama
MODEL_PROVIDER=fake

# Ollama (opcionális)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:2b
MODEL_TIMEOUT_MS=240000
MODEL_NUM_CTX=4096
MODEL_NUM_PREDICT=120
OLLAMA_NUM_THREAD=4

# A Node szerver kötése (adapter-node)
HOST=127.0.0.1
PORT=3000

# Csak reverse proxy mögött:
# PROTOCOL_HEADER=x-forwarded-proto
